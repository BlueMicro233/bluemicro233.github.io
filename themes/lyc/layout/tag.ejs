<section id="archive">
  <span class="h1"><a href="<%- url_for('/tags/') %>">Tag</a> <span class="archive-filter">/ <%= page.tag %></span></span>
  <ul class="post-list">
    <% page.posts.each(function (post) { %>
    <li class="post-item">
      <div class="meta"><time datetime="<%- date_xml(post.date) %>"><%= date(post.date, 'YYYY-MM-DD') %></time></div>
      <span><a href="<%- url_for(post.path) %>"><%= post.title %></a></span>
    </li>
    <% }) %>
  </ul>
  <%- partial('_partial/pagination') %>
</section>
